# Copy to the repo-root .env for local dev; set the same variables in the Vercel backend project.
HINDSIGHT_API_KEY=
HINDSIGHT_URL=https://api.hindsight.vectorize.io
GROQ_API_KEY=
# optional: several keys, comma-separated, no spaces; tried in order when one hits a Groq limit
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
MONGODB_URI=
MONGODB_DB=
# random string that signs login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CLIENT_URL=https://frontend-one-liart-v1r1f1weeq.vercel.app
# local only: password for the demo logins created by seed_demo.py
DEMO_PASSWORD=
